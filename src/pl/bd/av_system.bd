      "/ps7": {
        "address_spaces": {
          "Data": {
            "segments": {
              "SEG_audio_reg0": {
                "address_block": "/audio/S_AXI/reg0",
                "offset": "0x43C00000",
                "range": "64K"
              },
              "SEG_cam_gpio_Reg": {
                "address_block": "/cam_gpio/S_AXI/Reg",
                "offset": "0x41200000",
                "range": "64K"
              },
              "SEG_dma_Reg": {
                "address_block": "/dma/S_AXI_LITE/Reg",
                "offset": "0x40400000",
                "range": "64K"
              },
